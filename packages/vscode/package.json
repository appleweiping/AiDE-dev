{
  "name": "aide-vscode",
  "displayName": "AiDE — AI Development Environment",
  "description": "AI-powered coding assistant with multi-provider support, RAG indexing, and plugin marketplace",
  "version": "0.1.0",
  "publisher": "aide",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "assistant",
    "copilot",
    "chat",
    "llm",
    "openai",
    "anthropic",
    "claude",
    "gpt"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aide.startChat",
        "title": "AiDE: Start Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "aide.runAgent",
        "title": "AiDE: Run Agent on Selection",
        "icon": "$(play)"
      },
      {
        "command": "aide.selectProvider",
        "title": "AiDE: Select Provider / Model",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aide.indexProject",
        "title": "AiDE: Index Project for RAG",
        "icon": "$(database)"
      },
      {
        "command": "aide.clearChat",
        "title": "AiDE: Clear Chat History",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aide-sidebar",
          "title": "AiDE",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "aide-sidebar": [
        {
          "type": "webview",
          "id": "aide.chatView",
          "name": "Chat",
          "icon": "$(comment-discussion)",
          "contextualTitle": "AiDE Chat"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "aide.runAgent",
          "when": "editorHasSelection",
          "group": "aide@1"
        }
      ],
      "commandPalette": [
        {
          "command": "aide.startChat"
        },
        {
          "command": "aide.runAgent"
        },
        {
          "command": "aide.selectProvider"
        },
        {
          "command": "aide.indexProject"
        },
        {
          "command": "aide.clearChat"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aide.startChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ],
    "configuration": {
      "title": "AiDE",
      "properties": {
        "aide.provider": {
          "type": "string",
          "default": "openai",
          "enum": [
            "openai",
            "anthropic",
            "ollama",
            "openrouter",
            "custom"
          ],
          "enumDescriptions": [
            "OpenAI (GPT-4, GPT-3.5, etc.)",
            "Anthropic (Claude models)",
            "Ollama (local models)",
            "OpenRouter (multi-provider gateway)",
            "Custom OpenAI-compatible endpoint"
          ],
          "description": "LLM provider to use"
        },
        "aide.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the selected provider. Leave empty to use AIDE_API_KEY environment variable.",
          "markdownDescription": "API key for the selected provider. Leave empty to use `AIDE_API_KEY` environment variable."
        },
        "aide.model": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Model name to use (e.g. gpt-4o, claude-3-5-sonnet-20241022, llama3)"
        },
        "aide.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Custom base URL for OpenAI-compatible providers (e.g. http://localhost:11434/v1 for Ollama)"
        },
        "aide.maxTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 256,
          "maximum": 128000,
          "description": "Maximum tokens per response"
        },
        "aide.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Sampling temperature (0 = deterministic, 2 = very random)"
        },
        "aide.enableRag": {
          "type": "boolean",
          "default": true,
          "description": "Enable RAG (Retrieval-Augmented Generation) to include relevant code context in prompts"
        },
        "aide.ragTopK": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Number of code chunks to retrieve for RAG context"
        },
        "aide.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "Custom system prompt to prepend to all conversations"
        },
        "aide.autoIndexOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-index changed files when saved"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "package": "vsce package",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aide/core": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.8.0"
  }
}
